#!/usr/bin/env python3
"""
termux - 自动发现局域网内开放的 Termux SSH 主机并生成 SSH 命令

默认行为：解析并扫描后，把完整的 ssh 命令预填到终端（tmux 环境），
或打印到 stdout（其他环境），不会自动执行。

用法:
  termux                  # 生成默认用户名的 ssh 命令
  termux 456              # 生成 u0_a456@<IP> 的 ssh 命令
  termux u10_a456         # 直接指定完整用户名
  termux 456 ls -la       # 生成带远程命令的 ssh 命令

选项:
  -c, --cidr    扫描网段           (默认 192.168.1.0/24)
  -p, --port    SSH 端口           (默认 8022)
  -u, --user    默认用户名         (默认 u0_a123)
  -t, --timeout TCP 探测超时(秒)   (默认 1.0)
  --print       只打印命令，不尝试预填

配合 shell 函数使用（非 tmux 环境预填）:
  # Bash:
  termux() { local c; c=$(command termux "$@") || return; [ -n "$c" ] && read -e -i "$c" && eval "$REPLY"; }
  # Zsh:
  termux() { local c; c=$(command termux "$@") || return; [ -n "$c" ] && print -z "$c"; }
"""

from __future__ import annotations

import ipaddress
import os
import shlex
import socket
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed

DEFAULT_CIDR = "192.168.1.0/24"
DEFAULT_PORT = 8022
DEFAULT_USER = "u0_a123"
DEFAULT_TIMEOUT = 1.0
WORKERS = 128


def is_open(ip: str, port: int, timeout: float):
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            return ip
    except OSError:
        return None


def scan(cidr: str, port: int, timeout: float):
    net = ipaddress.ip_network(cidr, strict=False)
    hosts = [str(h) for h in net.hosts()]
    found = []
    with ThreadPoolExecutor(max_workers=WORKERS) as ex:
        futs = {ex.submit(is_open, ip, port, timeout): ip for ip in hosts}
        for f in as_completed(futs):
            r = f.result()
            if r:
                found.append(r)
    found.sort(key=lambda x: tuple(int(p) for p in x.split(".")))
    return found


def resolve_user(arg, default_user: str) -> str:
    if arg is None:
        return default_user
    if arg.isdigit():
        return f"u0_a{arg}"
    return arg


def build_ssh_command(user: str, ip: str, port: int, remote_cmd):
    parts = [
        "ssh",
        "-p", str(port),
        "-o", "StrictHostKeyChecking=accept-new",
        f"{user}@{ip}",
    ]
    if remote_cmd:
        parts += [shlex.quote(c) for c in remote_cmd]
    return " ".join(parts)


def try_prefill_tmux(cmd: str) -> bool:
    """在 tmux 环境下把命令预填到当前 pane（不按回车）。"""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return False
    try:
        subprocess.run(
            ["tmux", "send-keys", "-t", pane, "-l", cmd],
            check=True,
        )
        return True
    except (FileNotFoundError, subprocess.CalledProcessError):
        return False


def print_help() -> None:
    print(__doc__.strip())


def parse_args(argv):
    cidr = DEFAULT_CIDR
    port = DEFAULT_PORT
    user = DEFAULT_USER
    timeout = DEFAULT_TIMEOUT
    target = None
    command = []
    force_print = False

    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print_help()
            sys.exit(0)
        elif a == "--print":
            force_print = True
            i += 1
        elif a in ("-c", "--cidr"):
            cidr = argv[i + 1]; i += 2
        elif a in ("-p", "--port"):
            port = int(argv[i + 1]); i += 2
        elif a in ("-u", "--user"):
            user = argv[i + 1]; i += 2
        elif a in ("-t", "--timeout"):
            timeout = float(argv[i + 1]); i += 2
        else:
            target = a
            command = argv[i + 1:]
            break
    return cidr, port, user, timeout, target, command, force_print


def main() -> int:
    cidr, port, default_user, timeout, target, command, force_print = parse_args(sys.argv[1:])
    user = resolve_user(target, default_user)

    print(f"[termux] 扫描 {cidr} 端口 {port} ...", file=sys.stderr)
    ips = scan(cidr, port, timeout)

    if not ips:
        print("[termux] 没有找到开放该端口的主机", file=sys.stderr)
        return 1

    print(f"[termux] 发现 {len(ips)} 台候选: {', '.join(ips)}", file=sys.stderr)

    ip = ips[0]
    if len(ips) > 1:
        print(f"[termux] 选择第一台: {ip}", file=sys.stderr)

    cmd = build_ssh_command(user, ip, port, command)

    if not force_print and try_prefill_tmux(cmd):
        print("[termux] 已预填到终端，按回车执行", file=sys.stderr)
        return 0

    # 非 tmux：把命令打印到 stdout，方便 shell 函数捕获
    print(cmd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
