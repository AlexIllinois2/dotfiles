#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
gru.py - 批量拉取多个本地 Git 仓库
用法: python gru.py
配置: 修改下面的 REPOS 列表，填入本地路径和远程链接（支持 ~ 和 $HOME 等环境变量）
"""

import os
import sys
import subprocess
from pathlib import Path

# ---------- 在这里配置你要管理的 Git 仓库路径 ----------
REPOS = [
    ("~/.local/share/fcitx5/rime", "git@github.com:iDvel/rime-ice.git"),
    ("$HOME/.local/share/zsh/plugins/zsh-completions.git", "git@github.com:zsh-users/zsh-completions.git"),
    ("$HOME/.local/share/zsh/plugins/fzf-tab.git", "git@github.com:Aloxaf/fzf-tab.git"),
    ("$HOME/.local/share/zsh/themes/powerlevel10k.git", "git@github.com:romkatv/powerlevel10k.git"),
    
    # 添加更多仓库...
]
# -----------------------------------------------------

def expand_path(path_str: str) -> Path:
    """展开路径中的 ~ 和 $VAR 环境变量，并返回 Path 对象"""
    expanded = os.path.expanduser(os.path.expandvars(path_str))
    return Path(expanded).resolve()

def is_git_repo(path: Path) -> bool:
    """检查路径是否是一个有效的 Git 仓库"""
    return (path / ".git").exists()

def git_clone(repo_path: Path, remote_url: str) -> bool:
    """克隆缺失的仓库，仅获取最新提交。"""
    try:
        repo_path.parent.mkdir(parents=True, exist_ok=True)
        print(f"\n>>> 正在克隆: {remote_url} -> {repo_path}")
        result = subprocess.run(
            ["git", "clone", "--depth", "1", remote_url, str(repo_path)],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            print("✅ 克隆成功")
            return True
        print("❌ 克隆失败:")
        if result.stderr:
            print(result.stderr.strip(), file=sys.stderr)
        return False
    except Exception as e:
        print(f"❌ 执行 git clone 时发生异常: {e}")
        return False

def git_pull(repo_path: Path) -> bool:
    """
    在指定仓库路径执行 git pull
    返回 True 表示成功，False 表示失败
    """
    try:
        print(f"\n>>> 正在拉取: {repo_path}")
        # 运行 git pull，捕获输出
        result = subprocess.run(
            ["git", "pull"],
            cwd=repo_path,
            capture_output=True,
            text=True,
            check=False
        )
        if result.returncode == 0:
            # 输出 git pull 的结果
            if result.stdout:
                print(result.stdout.strip())
            if result.stderr:
                print(result.stderr.strip(), file=sys.stderr)
            print("✅ 成功")
            return True
        else:
            # 失败时打印错误信息
            print("❌ 拉取失败:")
            if result.stderr:
                print(result.stderr.strip(), file=sys.stderr)
            if result.stdout:
                print(result.stdout.strip())
            return False
    except Exception as e:
        print(f"❌ 执行 git pull 时发生异常: {e}")
        return False

def main():
    success_count = 0
    failure_count = 0

    for local_path, remote_url in REPOS:
        repo = expand_path(local_path)
        if not repo.exists():
            if git_clone(repo, remote_url):
                success_count += 1
            else:
                failure_count += 1
            continue
        if not repo.is_dir():
            print(f"⚠️  不是目录，已跳过: {repo}")
            failure_count += 1
            continue
        if not is_git_repo(repo):
            print(f"⚠️  不是 Git 仓库（缺少 .git），已跳过: {repo}")
            failure_count += 1
            continue
        if git_pull(repo):
            success_count += 1
        else:
            failure_count += 1

    if not REPOS:
        print("没有配置仓库，请检查 REPOS 配置。")
        sys.exit(1)

    print(f"共 {len(REPOS)} 个仓库处理完成")
    # 汇总结果
    print("\n" + "=" * 50)
    print(f"完成: 成功 {success_count} 个，失败 {failure_count} 个")
    if failure_count > 0:
        sys.exit(1)
    else:
        sys.exit(0)

if __name__ == "__main__":
    main()
