#!/usr/bin/env bash
# 打印目录大小
# 用法:
#   ./dirsize.sh [目录]        # 默认：打印目录总大小和条目数
#   ./dirsize.sh -l [目录]     # 列出目录下各子目录大小，按大小降序

usage() {
    echo "用法: $0 [-l] [目录]" >&2
    exit 1
}

list_mode=0

while getopts ":l" opt; do
    case "$opt" in
        l) list_mode=1 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

dir="${1:-.}"

if [ ! -d "$dir" ]; then
    echo "错误: 不是目录: $dir" >&2
    exit 1
fi

if [ "$list_mode" -eq 1 ]; then
    # 第二段逻辑：列出该目录下所有子目录大小
    find "$dir" -mindepth 1 -maxdepth 1 -type d \
        -exec du -sh {} + 2>/dev/null | sort -rh
else
    # 第一段逻辑：打印目录总大小和条目数
    c="$(ls -a "$dir" | wc -l)"
    total="$((c - 2))"
    echo "total: $total $(du -hs "$dir")"
fi
