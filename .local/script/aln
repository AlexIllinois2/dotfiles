#!/usr/bin/env python3
import os, sys

def abspath(p):
    return os.path.abspath(p) if p else os.getcwd()

def main(argv):
    out, next_type, after_dd = [], None, False
    for arg in argv:
        if next_type == 'suffix':
            out.append(arg); next_type = None; continue
        if next_type == 'dir':
            out.append(abspath(arg)); next_type = None; continue
        if after_dd:
            out.append(abspath(arg)); continue
        if arg == '--':
            out.append(arg); after_dd = True; continue

        if arg.startswith('--'):
            if arg.startswith('--suffix='):
                out.append(arg)
            elif arg == '--suffix':
                out.append(arg); next_type = 'suffix'
            elif arg.startswith('--suf') and '=' not in arg:
                out.append(arg); next_type = 'suffix'
            elif arg.startswith('--target-directory='):
                out.append('--target-directory=' + abspath(arg.split('=', 1)[1]))
            elif arg == '--target-directory':
                out.append(arg); next_type = 'dir'
            elif arg.startswith('--target') and '=' in arg:
                k, v = arg.split('=', 1)
                out.append(f'{k}={abspath(v)}')
            elif arg.startswith('--target'):
                out.append(arg); next_type = 'dir'
            else:
                out.append(arg)
            continue

        if arg.startswith('-') and arg != '-':
            body, opt, i, handled = arg[1:], '-', 0, False
            while i < len(body):
                c = body[i]; opt += c; i += 1
                if c in 'St':
                    rest = body[i:]
                    if rest:
                        out.append(opt + (abspath(rest) if c == 't' else rest))
                    else:
                        out.append(opt)
                        next_type = 'suffix' if c == 'S' else 'dir'
                    handled = True
                    break
            if not handled:
                out.append(opt)
            continue

        out.append(abspath(arg))

    os.execvp('ln', ['ln'] + out)

if __name__ == '__main__':
    main(sys.argv[1:])
