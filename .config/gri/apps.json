{
  "AnInsomniacy/motrix-next": {
    "repo": "AnInsomniacy/motrix-next"
  },
  "astral-sh/uv": {
    "filter": [
      {
        "field": "os",
        "op": "in",
        "value": [
          "linux"
        ]
      },
      {
        "field": "arch",
        "op": "in",
        "value": [
          "x86_64",
          "x86-64",
          "amd64",
          "x64"
        ]
      },
      {
        "field": "libc",
        "op": "in",
        "value": [
          "gnu"
        ]
      },
      {
        "field": "contains",
        "op": "contains",
        "value": "uv-x86_64-unknown-linux-gnu.tar.gz"
      }
    ],
    "layout": {
      "bins": [
        {
          "path": "uv"
        },
        {
          "path": "uvx"
        }
      ],
      "stripComponents": 1
    },
    "repo": "astral-sh/uv",
    "type": "archive"
  },
  "clash-verge-rev/clash-verge-rev": {
    "repo": "clash-verge-rev/clash-verge-rev"
  },
  "docmirror/dev-sidecar": {
    "repo": "docmirror/dev-sidecar"
  },
  "earendil-works/pi": {
    "filter": [
      {
        "field": "os",
        "op": "in",
        "value": [
          "linux"
        ]
      },
      {
        "field": "arch",
        "op": "in",
        "value": [
          "x86_64",
          "x86-64",
          "amd64",
          "x64"
        ]
      },
      {
        "field": "libc",
        "op": "in",
        "value": [
          "gnu"
        ]
      },
      {
        "field": "contains",
        "op": "contains",
        "value": "pi-linux-x64.tar.gz"
      }
    ],
    "layout": {
      "bins": [
        {
          "path": "pi"
        }
      ],
      "stripComponents": 1
    },
    "repo": "earendil-works/pi",
    "type": "archive"
  },
  "ggml-org/llama.cpp": {
    "repo": "ggml-org/llama.cpp"
  },
  "jswysnemc/mark-shot": {
    "repo": "jswysnemc/mark-shot"
  },
  "localsend/localsend": {
    "repo": "localsend/localsend"
  },
  "oven-sh/bun": {
    "repo": "oven-sh/bun"
  }
}